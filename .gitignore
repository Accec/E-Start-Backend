# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Local environment and mode-specific configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template
/src/core/config/*.yaml
/src/core/config/*.yml
!/src/core/config/base.yaml
!/src/core/config/sample.yaml

# Runtime data (do not hide resource directories named logs or uploads)
*.log
/logs/
/src/logs/
/uploads/
/src/uploads/
dump.rdb

# Test, type-checking, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
/coverage.xml

# Python packaging output
/build/
/dist/
.eggs/
*.egg-info/
